# Raw clinical / patient data must NEVER be committed
# (anchored to repo root - do NOT remove the leading slash, otherwise
# this also silently swallows src/data/ and any other */data/ directory)
/data/
*.csv
*.parquet
*.json
*.sqlite
*.db
*.h5
*.hdf5
*.feather
*.pkl
*.pickle

# Exceptions: small, explicitly-safe/public reference files are allowed
!research/LITERATURE_MATRIX.csv
# Aggregate experiment RESULTS (e.g. model-name + metric tables) are safe
# to commit - they contain no patient-level data, only summary metrics.
# Anything under data/ is still excluded regardless (see /data/ above).
!research/RESULTS/**/*.csv
# Final compiled-report figures (aggregate plots, no patient-level data)
# are a deliverable, unlike the regenerable working figures under
# research/FIGURES/.
!docs/figures/**/*.png
!**/schema*.json
!**/config*.json
!configs/**/*.json
!.vscode/*.json

# Credentials / secrets
*.env
.env.*
**/credentials*
**/*secret*
**/*token*
!**/*secret*.md
!**/*token*.md

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Experiment artifacts (large, regenerable)
research/RESULTS/**/*.png
research/FIGURES/**/*.png
!research/FIGURES/**/*.md
mlruns/
wandb/
.ipynb_checkpoints/

# OS
.DS_Store
